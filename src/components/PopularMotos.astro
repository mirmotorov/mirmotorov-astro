---
import popularMotos from '../data/products.json';
import MotoCard from './MotoCard.astro';---
<section class="popular">
  <h2>Популярная техника</h2>
  <div class="grid">
    {popularMotos.map(moto => <MotoCard moto={moto} />)}
  </div>
  <a href={u("/catalog")} class="btn-all">Смотреть весь каталог →</a>
</section>

<style>
  .popular {
    padding: 3rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }
  h2 {
    text-align: center;
    margin-bottom: 2rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
  }
  .btn-all {
    display: inline-block;
    margin-top: 2rem;
    padding: 0.8em 1.5em;
    background: #111;
    color: white;
    text-decoration: none;
    border-radius: 5px;
  }
</style>