---
import categories from '../data/categories.json';
import { categoryToSlug } from '../utils/transliterate';

// ⭐ Прямой glob всех картинок категорий — НИКАКИХ ручных импортов, добавил файл = подтянулся
const catImages = import.meta.glob('/src/assets/images/categories/*.{jpg,jpeg,png,webp}', {
  eager: true,
  import: 'default',
}) as Record<string, any>;

function findCatImg(slug: string, title: string): any | null {
  const slugLow = (slug || '').toLowerCase();
  const titleLow = (title || '').toLowerCase();
  for (const [path, img] of Object.entries(catImages)) {
    const p = path.toLowerCase();
    if (p.includes(slugLow)) return img;
  }
  // запасной вариант: поиск по словам в названии
  for (const [path, img] of Object.entries(catImages)) {
    const p = path.toLowerCase();
    if (titleLow && p.includes(titleLow.slice(0, 8))) return img;
  }
  return null;
}

// ⭐⭐⭐ ПРАВИЛЬНЫЕ ссылки (на реальные страницы каталога)
const CATEGORY_OVERRIDES: Record<string, string> = {
  zapchasti:   '/parts',
  aksessuary:  '/catalog-aksessuary',
  ekipirovka:  '/odezhda-i-ehkipirovka',
  service:     '/service',
};

const list = categories.map((cat: any) => {
  const slug = cat.slug || categoryToSlug(cat.title);
  const href = CATEGORY_OVERRIDES[slug] || `/catalog/${slug}`;
  return {
    ...cat,
    slug,
    href,
    image: findCatImg(slug, cat.title) || cat.image || null,
  };
});
---

<section class="categories">
  <div class="grid">
    {list.map((cat) => (
      <a href={cat.href} class="cat-card" title={cat.title}>
        <div class="cat-img">
          {cat.image ? (
            // ⭐ БЕЗ ВСЯКИХ object-fit: ВАША 1200px-КАРТИНКА width:100% — ЕСТЕСТВЕННЫЙ ВИД
            <img src={typeof cat.image === 'string' ? cat.image : cat.image.src}
                 alt={cat.title}
                 loading="lazy"
                 decoding="async"
            />
          ) : (
            <div class="cat-plug">
              <span>{cat.emoji || '🚜'}</span>
              <small>Положите картинку в<br/>src/assets/images/categories/{cat.slug}.jpg</small>
            </div>
          )}
        </div>
        <div class="cat-name">
          <span>{cat.title}</span>
        </div>
      </a>
    ))}
  </div>
</section>

<style>
/* ╔════════════════════════════════════════════════════════════════════════════╗
   ║  🔧🔧🔧   НАСТРОЙКА РАЗМЕРОВ КАТЕГОРИЙ НА ГЛАВНОЙ — ВСЁ ЗДЕСЬ!   🔧🔧🔧   ║
   ╚════════════════════════════════════════════════════════════════════════════╝*/

  /* ========== 1) ШИРИНА ВСЕЙ СЕТКИ ========== */
  .categories {
    padding: 2.5rem 0 3.5rem;
    max-width: 1400px;  /* ← как header/footer (не трогать) */
    margin: 0 auto;
    width: 100%;
    box-sizing: border-box;
  }

  /* ========== 2) СКОЛЬКО КАРТОЧЕК В РЯД + РАССТОЯНИЕ МЕЖДУ НИМИ ==========
     Меняйте ЦИФРЫ ниже:                                                                 
       repeat(4, 1fr) → 4 в ряд (карточки маленькие)
       repeat(3, 1fr) → 3 в ряд (сейчас)
       repeat(2, 1fr) → 2 в ряд (ОГРОМНЫЕ карточки)
       gap: 2rem     → расстояние МЕЖДУ карточками (2rem = 32px)                      */
  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.75rem;
    padding: 0 24px;
    box-sizing: border-box;
  }
  /* (адаптив под мобильные — не трогать) */
  @media (max-width: 1080px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px)  { .grid { grid-template-columns: 1fr; gap: 1.2rem; padding: 0 16px; } }

  /* ========== 3) ВНЕШНИЙ ВИД КАРТОЧКИ ========== */
  .cat-card {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    /* aspect-ratio: 4 / 3; */  /* ← 👉 ЕСЛИ ХОТИТЕ ВСЕ КАРТОЧКИ ОДИНАКОВОЙ ВЫСОТЫ — раскомментируйте */
    background: #ffffff;       /* ← фон карточки — сейчас чисто белый */
    border-radius: 14px;        /* ← скругление углов (0 = острые углы) */
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    box-shadow: 0 6px 22px rgba(0,0,0,0.09); /* ← ТЕНЬ (убрать если надо = 0) */
    transition: transform 0.25s ease-out, box-shadow 0.25s ease-out;
    border: 1px solid #eef0f3; /* ← ТОНКАЯ РАМКА (убрать = none) */
  }
  .cat-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 22px 50px rgba(0,0,0,0.18);
    border-color: #fcd34d;   /* ← желтая рамка при наведении */
  }

  /* ═══════════════════════════════════════════════════════════════
     🔴🔴🔴 4) РАЗМЕРЫ КАРТИНКИ ВНУТРИ КАРТОЧКИ — ЗДЕСЬ 🔴🔴🔴
     ═══════════════════════════════════════════════════════════════
     padding — белое поле ВОКРУГ картинки (0 = без полей)
  */
  .cat-img {
    width: 100%;
    flex: 1 1 auto;
    background: #ffffff;   /* фон = белый */
    overflow: hidden;
    padding: 12px;        /* 👈 ОТСТУП ВНУТРИ (12px = небольшое поле; 0 = совсем впритык) */
    /* Если раскомментировали aspect-ratio выше и картинка маленькая
       (не заполняет всю рамку) — добавьте эти 3 строки:
    display: flex;
    align-items: center;
    justify-content: center; */
  }

  /* ⚠️ ⚠️ ⚠️  ЗАПРЕТ НА ЛЮБОЕ РАСТЯЖЕНИЕ / ОБРЕЗАНИЕ.
     Картинка ВСТАЕТ КАК ЕСТЬ — ровно 100% ширины, высота сама.
     Никаких object-fit: contain / cover / fill — УДАЛЕНО НАВСЕГДА.      */
  .cat-img img {
    display: block;
    width: 100%;
    height: auto;
    max-width: 100%;
    max-height: none;
    border-radius: 6px;   /* скругление углов самой картинки (0 = нет) */
    transition: transform 0.4s ease-out;  /* легкий zoom при наведении (убрать если надо) */
  }
  .cat-card:hover .cat-img img { transform: scale(1.04); }  /* ← убрать эту строку чтобы zoomа не было */

  /* Заглушка если нет картинки (подсказывает куда положить файл) */
  .cat-plug {
    width: 100%; min-height: 220px;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    gap: 0.6rem;
    background: #fff7ed; color: #92400e;
    text-align: center; padding: 1rem;
  }
  .cat-plug span { font-size: 4rem; line-height: 1; }
  .cat-plug small { font-size: 0.72rem; line-height: 1.4; }

  /* ========== 5) ПОДПИСЬ НИЖНЯЯ ========== */
  .cat-name {
    flex: 0 0 auto;
    padding: 14px 22px 18px;
    border-top: 1px solid #f1f2f4;
    background: #fff;
  }
  .cat-name span {
    display: block;
    font-family: 'Segoe UI', Arial, sans-serif;
    color: #111827;
    font-size: 1.15rem;   /* ← размер шрифта названия категории */
    font-weight: 800;
    line-height: 1.22;
  }
  .cat-card:hover .cat-name span { color: #b45309; }
</style>