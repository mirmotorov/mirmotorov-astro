import maxIcon from '../assets/images/icon/max.jpg';---
<div class="footer-wrapper">
  <footer class="footer">
    <div class="footer__grid">
      <div class="footer__col footer__col--contacts">
        <a href={u("/")} class="footer__logo">Мир моторов</a>
        <p class="footer__contacts-label">Свяжитесь с нами:</p>
        <ul class="footer__contacts">
          <li><a href="tel:+73912360515">8 (391) 236‑05‑15</a></li>
          <li><a href="mailto:office@yamaha24.ru">office@yamaha24.ru</a></li>
          <li>ООО «Автодом «На Королева»<br>ИНН 2464024615 / ОГРН 1022402302592</li>
          <li>660064 РФ, Красноярский край,<br>г. Красноярск, ул. Академика Вавилова, д. 1, к. «Г», пом. 2</li>
          <li>Часы работы:<br>Пн–Пт: 9:00 – 19:00<br>Сб: 9:00 – 17:00<br>Вс: выходной</li>
        </ul>
        <div class="footer__social">
          <a href="https://vk.com/yourpage" target="_blank" rel="noopener" aria-label="ВКонтакте" class="social social--vk">
            <img src={vkIcon.src} alt="ВКонтакте" width="40" height="40" />
          </a>
          <a href="https://t.me/yourusername" target="_blank" rel="noopener" aria-label="Telegram" class="social social--tg">
            <svg viewBox="0 0 48 48" width="40" height="40" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <defs>
                <linearGradient id="tgGradF" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#27A7E6" stop-opacity="1"/>
                  <stop offset="100%" stop-color="#1E96C8" stop-opacity="1"/>
                </linearGradient>
              </defs>
              <circle cx="24" cy="24" r="24" fill="url(#tgGradF)"/>
              <path d="M37.8 14.5L32.4 35.9c-.3 1.2-1 1.5-2.1.9l-6.3-4.7-3 2.8c-.3.3-.6.6-1.3.6l.5-6.5 11.9-10.9c.5-.5-.1-.8-.8-.3l-14.7 9.3-6.3-2c-1.3-.4-1.4-1.4.3-2L35.8 13c.8-.3 1.9.2 2 1.5z" fill="#ffffff"/>
            </svg>
          </a>
          <a href="https://max.ru/yourid" target="_blank" rel="noopener" aria-label="MAX Мессенджер" class="social social--max">
            <img src={maxIcon.src} alt="MAX Мессенджер" width="40" height="40" />
          </a>
        </div>
      </div>
      <div class="footer__col">
        <h3>Техника</h3>
        <ul>
          <li><a href={u("/kvadrocikl-aodes")}>Квадроциклы AODES</a></li>
          <li><a href={u("/stels-kvadrocikli")}>Квадроциклы STELS</a></li>
          <li><a href={u("/kvadrocikl-segway")}>Квадроциклы SEGWAY</a></li>
          <li><a href={u("/snegohod-aodes")}>Снегоходы AODES</a></li>
          <li><a href={u("/stels-snegohody")}>Снегоходы STELS</a></li>
          <li><a href={u("/vezdehodi-tinger")}>Вездеходы TINGER</a></li>
        </ul>
      </div>
      <div class="footer__col">
        <h3>Водная техника</h3>
        <ul>
          <li><a href={u("/lodochnyj-motor-gladiator")}>Лодочные моторы Gladiator</a></li>
          <li><a href={u("/lodochnye-motory-parsun")}>Лодочные моторы Parsun</a></li>
          <li><a href={u("/lodochnye-motory-golfstream")}>Лодочные моторы GOLFSTREAM</a></li>
          <li><a href={u("/lodochnye-motory-sea-pro")}>Лодочные моторы SEA-PRO</a></li>
          <li><a href={u("/lodki-gladiator")}>Лодки Gladiator</a></li>
        </ul>
      </div>
      <div class="footer__col">
        <h3>Товары и услуги</h3>
        <ul>
          <li><a href={u("/catalog-aksessuary")}>Аксессуары</a></li>
          <li><a href={u("/odezhda-i-ehkipirovka")}>Экипировка</a></li>
          <li><a href={u("/parts")}>Запчасти</a></li>
          <li><a href={u("/service")}>Сервис</a></li>
          <li><a href={u("/tuning")}>Тюнинг</a></li>
        </ul>
      </div>
      <div class="footer__col">
        <h3>Информация</h3>
        <ul>
          <li><a href={u("/megacredit")}>Мегакредит</a></li>
          <li><a href={u("/megarenta")}>МегаАренда</a></li>
          <li><a href={u("/dostavka-i-oplata")}>Доставка и оплата</a></li>
          <li><a href={u("/policy")}>Политика конфиденциальности</a></li>
          <li><a href={u("/aboutus")}>О нас</a></li>
          <li><a href={u("/contacts")}>Контакты</a></li>
        </ul>
      </div>
    </div>
    <div class="footer__bottom">
      <p>© 2016–2026 ООО «Автодом «На Королева» (ИНН 2464024615, ОГРН 1022402302592). Мир Моторов — торговая марка.</p>
    </div>
  </footer>
</div>

<style>
  :root {
    --brand-red: #ED3333;
    --brand-red-hover: #d62a2a;
    --brand-white: #ffffff;
    --brand-dark: #0f1423;
    --brand-border: #222a45;
    --font-main: 'Segoe UI', system-ui, -apple-system, Arial, sans-serif;
  }
  .footer-wrapper { background-color: var(--brand-dark); width: 100%; color: #ccc; font-family: var(--font-main); }
  .footer { max-width: 1400px; margin: 0 auto; padding: 2.2rem 20px 1.2rem; }
  .footer__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 2rem; margin-bottom: 2rem; }
  .footer__logo { color: var(--brand-white); font-size: 1.6rem; font-weight: 800; text-decoration: none; letter-spacing: -0.01em; }
  .footer__contacts-label { color: #9ca3af; margin-top: 1rem; font-weight: 600; }
  .footer__contacts { list-style: none; padding: 0; font-size: 0.92rem; line-height: 1.7; color: #d1d5db; }
  .footer__contacts a { color: var(--brand-white); text-decoration: none; font-weight: 600; transition: color 0.2s; }
  .footer__contacts a:hover { color: var(--brand-red); }
  /* ===== ФУТЕР ИКОНКИ: VK/Telegram SVG БЕЗ БЕЛОЙ ОКОЙМКИ! MAX = ВАША КАРТИНКА ===== */
  .footer__social { margin-top: 1rem; display: flex; gap: 0.8rem; }
  .footer__social .social {
    width: 40px; height: 40px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    overflow: hidden; text-decoration: none;
    background: transparent; border: none;
    padding: 0; margin: 0;
    transition: transform 0.15s;
  }
  .footer__social .social:hover { transform: translateY(-2px) scale(1.05); }
  .footer__social .social--vk img {
    width: 40px; height: 40px; object-fit: cover; display: block;
    padding: 0; margin: 0; border-radius: 50%;
  }
  .footer__social .social svg {
    width: 40px; height: 40px; display: block; padding: 0; margin: 0;
    border-radius: 50%;
  }
  .footer__social .social--max img {
    width: 40px; height: 40px; object-fit: cover; display: block;
    padding: 0; margin: 0;
    border-radius: 50%;
  }
  .footer__col h3 { color: var(--brand-white); margin-bottom: 0.6rem; font-size: 1.05rem; font-weight: 800; }
  .footer__col ul { list-style: none; padding: 0; }
  .footer__col ul li { margin-bottom: 0.45rem; }
  .footer__col ul a { color: #d1d5db; text-decoration: none; font-size: 0.92rem; font-weight: 500; transition: color 0.2s; }
  .footer__col ul a:hover { color: var(--brand-red); }
  .footer__bottom { border-top: 1px solid var(--brand-border); padding-top: 1rem; text-align: left; font-size: 0.88rem; color: #888; line-height: 1.5; }
</style>