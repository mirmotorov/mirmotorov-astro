---
import vkIcon from '../assets/images/icon/vk.jpg';
import maxIcon from '../assets/images/icon/max.jpg';
import { u } from '../utils/_urls.astro';
const currentPath = Astro.url.pathname;
const isActive = (path) => currentPath === path ? 'active' : '';---

<div class="header-wrapper">
  <header class="header">
    <div class="header__top">
      <a href={u("/")} class="header__logo">Мир моторов</a>
      <form class="header__search" action="/search" method="get">
        <input type="text" name="q" placeholder="Поиск по сайту..." class="search__input" />
        <button type="submit" class="search__btn">Поиск</button>
      </form>
      <div class="header__actions">
        <a href="https://vk.com/yourpage" class="action-icon action-icon--vk" target="_blank" rel="noopener" title="ВКонтакте" aria-label="ВКонтакте">
          <img src={vkIcon.src} alt="ВКонтакте" width="40" height="40" />
        </a>
        <a href="https://t.me/yourusername" class="action-icon action-icon--tg" target="_blank" rel="noopener" title="Telegram" aria-label="Telegram">
          <svg viewBox="0 0 48 48" width="40" height="40" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <defs>
              <linearGradient id="tgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#27A7E6" stop-opacity="1"/>
                <stop offset="100%" stop-color="#1E96C8" stop-opacity="1"/>
              </linearGradient>
            </defs>
            <circle cx="24" cy="24" r="24" fill="url(#tgGrad)"/>
            <path d="M37.8 14.5L32.4 35.9c-.3 1.2-1 1.5-2.1.9l-6.3-4.7-3 2.8c-.3.3-.6.6-1.3.6l.5-6.5 11.9-10.9c.5-.5-.1-.8-.8-.3l-14.7 9.3-6.3-2c-1.3-.4-1.4-1.4.3-2L35.8 13c.8-.3 1.9.2 2 1.5z" fill="#ffffff"/>
          </svg>
        </a>
        <a href="https://max.ru/yourid" class="action-icon action-icon--max" target="_blank" rel="noopener" title="MAX Мессенджер" aria-label="MAX Мессенджер">
          <img src={maxIcon.src} alt="MAX Мессенджер" width="40" height="40" />
        </a>
        <a href={u("/cart")} class="header__cart action-icon" aria-label="Корзина" title="Корзина">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
        </a>
        <a href="tel:+73912720555" class="phone-text-btn" title="Позвонить нам сейчас">8 (391)&nbsp;272‑05‑55</a>
      </div>
    </div>
    <nav class="header__nav">
      <a href={u("/catalog")} class={`nav__btn nav__btn--catalog ${isActive('/catalog')}`}>Каталог</a>
      <div class="nav__dropdown">
        <button class="nav__link">Владельцам</button>
        <div class="dropdown__content">
          <a href={u("/tuning")}>Тюнинг</a>
          <a href={u("/service")}>Сервис и ремонт</a>
          <a href={u("/paper")}>Полезные статьи</a>
        </div>
      </div>
      <div class="nav__dropdown">
        <button class="nav__link">Покупателям</button>
        <div class="dropdown__content">
          <a href={u("/promos")}>Акции</a>
          <a href={u("/leasing")}>Лизинг для Юридических лиц</a>
          <a href={u("/credit")}>Рассрочка и кредитование</a>
          <a href={u("/dostavka-i-oplata")}>Доставка и оплата</a>
        </div>
      </div>
      <a href={u("/aboutus")} class={`nav__link ${isActive('/aboutus')}`}>О нас</a>
    </nav>
  </header>
</div>

<style>
  /* ===== ГЛОБАЛЬНЫЕ ПЕРЕМЕННЫЕ СТИЛЕЙ: НОВЫЙ КРАСНЫЙ #ED3333 + НОВЫЙ ТЁМНЫЙ #0f1423 ===== */
  :root {
    --brand-red: #ED3333;
    --brand-red-hover: #d62a2a;
    --brand-white: #ffffff;
    --brand-dark: #0f1423;
    --brand-dark-2: #0b0f1c;
    --brand-search: #151b30;
    --brand-border: #222a45;
    --font-main: 'Segoe UI', system-ui, -apple-system, Arial, sans-serif;
  }
  .header-wrapper { background-color: var(--brand-dark); width: 100%; }
  .header { background-color: var(--brand-dark); color: #ccc; font-family: var(--font-main); max-width: 1400px; margin: 0 auto; padding: 0 20px; }
  .header__top { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 14px 0; min-height: 62px; }
  .header__logo { font-size: 1.85rem; font-weight: 800; color: var(--brand-white); text-decoration: none; flex-shrink: 0; letter-spacing: -0.01em; }
  .header__search { display: flex; flex: 1; margin: 0 20px; border: 2px solid var(--brand-border); border-radius: 10px; overflow: hidden; background: var(--brand-search); }
  .search__input { flex: 1; border: none; padding: 10px 16px; font-size: 1rem; background: var(--brand-search); color: var(--brand-white); outline: none; font-family: var(--font-main); }
  .search__input::placeholder { color: #9ca3af; }
  .search__btn { background: var(--brand-red); border: none; padding: 10px 20px; font-weight: 800; color: var(--brand-white); cursor: pointer; transition: background 0.2s; font-family: var(--font-main); font-size: 0.95rem; }
  .search__btn:hover { background: var(--brand-red-hover); }
  .header__actions { display: flex; align-items: center; gap: 10px; flex-shrink: 0; height: 100%; }

  /* ===== ИКОНКИ СОЦСЕТЕЙ: VK + TELEGRAM = ВЕКТОРНЫЕ SVG БЕЗ БЕЛОЙ ОКОЙМКИ! MAX = ВАША КАРТИНКА ===== */
  .action-icon {
    display: flex; align-items: center; justify-content: center;
    width: 40px; height: 40px; text-decoration: none;
    border-radius: 50%;
    overflow: hidden;
    transition: transform 0.15s;
    background: transparent;
    padding: 0; margin: 0;
  }
  .action-icon:hover { transform: translateY(-1px) scale(1.04); }
  .action-icon svg {
    width: 40px; height: 40px;
    display: block; padding: 0; margin: 0;
  }
  .action-icon--vk img {
    width: 40px; height: 40px; object-fit: cover; display: block;
    padding: 0; margin: 0;
    border-radius: 50%;
  }
  .action-icon--vk svg, .action-icon--tg svg {
    border-radius: 50%;
  }
  .action-icon--max img {
    width: 40px; height: 40px; object-fit: cover; display: block;
    padding: 0; margin: 0;
    border-radius: 50%;
  }
  .phone-text-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 40px;
    padding: 0 1.05rem;
    background: var(--brand-red);
    color: var(--brand-white);
    text-decoration: none;
    border-radius: 999px;
    font-size: 1.02rem;
    font-weight: 800;
    letter-spacing: 0;
    white-space: nowrap;
    transition: background 0.2s, transform 0.15s;
  }
  .phone-text-btn:hover {
    background: var(--brand-red-hover);
    transform: translateY(-1px);
  }
  .phone-text-btn:active { transform: translateY(0); }

  /* ===== КОРЗИНА: теперь перед телефоном, красный круг, БОЛЬШАЯ БЕЛАЯ КОРЗИНА (28px) ===== */
  .header__cart.action-icon {
    background: var(--brand-red);
    color: var(--brand-white);
  }
  .header__cart.action-icon:hover {
    background: var(--brand-red-hover);
  }
  .header__cart svg { stroke: var(--brand-white); width: 28px; height: 28px; }

  .header__nav { display: flex; align-items: center; gap: 5px; padding: 8px 0 12px; font-family: var(--font-main); }

  /* ===== КНОПКА «КАТАЛОГ»: НОВЫЙ КРАСНЫЙ #ED3333 + БЕЛЫЙ ТЕКСТ! ===== */
  .nav__btn--catalog {
    background: var(--brand-red); color: var(--brand-white);
    padding: 11px 26px; border-radius: 10px; font-weight: 800;
    text-decoration: none; margin-right: 20px;
    box-shadow: 0 3px 10px rgba(237, 51, 51, 0.35);
    transition: background 0.2s, box-shadow 0.2s;
    border: none; display: inline-block; font-size: 1rem; line-height: 1.2;
  }
  .nav__btn--catalog:hover { background: var(--brand-red-hover); box-shadow: 0 5px 12px rgba(220,38,38,0.45); }
  .nav__link { background: none; border: none; color: #e5e7eb; font-size: 1rem; font-weight: 600; padding: 8px 18px; cursor: pointer; text-decoration: none; display: inline-block; position: relative; transition: color 0.2s; line-height: 1.2; font-family: var(--font-main); }
  .nav__link:hover { color: #fff; }
  .nav__link.active, .nav__btn--catalog.active { color: #fff; }
  .nav__link.active::after, .nav__btn--catalog.active::after { content: ''; position: absolute; left: 50%; bottom: -2px; transform: translateX(-50%); width: 60%; height: 2px; background-color: var(--brand-red); }
  .nav__dropdown { position: relative; }
  .nav__dropdown .dropdown__content { display: none; position: absolute; top: 100%; left: 0; background: var(--brand-dark-2); min-width: 240px; padding: 10px 0; border-radius: 8px; z-index: 20; box-shadow: 0 8px 20px rgba(0,0,0,0.35); border: 1px solid var(--brand-border); }
  .nav__dropdown:hover .dropdown__content { display: block; }
  .dropdown__content a { display: block; color: #d1d5db; padding: 10px 22px; text-decoration: none; font-size: 0.95rem; font-weight: 500; transition: background 0.2s, color 0.2s; font-family: var(--font-main); }
  .dropdown__content a:hover { background: var(--brand-red); color: var(--brand-white); }
  @media (max-width: 768px) {
    .header__top { flex-wrap: wrap; padding: 10px 0; }
    .header__search { order: 3; margin: 10px 0 0; flex-basis: 100%; }
    .header__actions { gap: 8px; }
    .action-icon, .header__cart { width: 36px; height: 36px; }
    .header__cart svg { width: 24px; height: 24px; }
    .phone-text-btn { font-size: 0.95rem; padding: 0 0.85rem; }
    .header__nav { flex-wrap: wrap; }
  }
</style>