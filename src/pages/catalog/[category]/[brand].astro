---
import Layout from '../../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getAllProducts, getProductsByBrand } from '../../../utils/load-products';
import { getProductImage } from '../../../utils/image-loader';
import { categoryToSlug, getMainCategory } from '../../../utils/transliterate';
// ✨ Astro Best Practice: ВСЕ regex / парсинг query — ТОЛЬКО в .ts (не в .astro frontmatter!)
import {
  getQueryParam,
  inRangeSafe as inRange,
  normTactSafe as normTact,
  normControlSafe as normControl,
  normPropulsionSafe as normPropulsion,
  normBoatTypeSafe as normBoatType,
  normFloorTypeSafe as normFloorType,
  cleanStrOnlyAlnum as cleanKey,
} from '../../../utils/query-parse';

export function getStaticPaths() {
  const all = getAllProducts();
  const paths = all
    .filter((p) => p.brandSlug && p.category)
    .map((p) => {
      const parts = (p.category || '').split('>>>');
      const brandFull = parts[1]?.split(';')[0]?.trim() || p.brand || '';
      const mainCat = getMainCategory(p.category) || parts[0]?.trim() || '';
      return {
        params: {
          category: categoryToSlug(p.category),
          brand: p.brandSlug,
        },
        props: {
          mainCatTitle: mainCat,
          mainCatSlug: categoryToSlug(mainCat),
          categoryTitle: parts[0]?.trim() ?? '',
          categorySlug: categoryToSlug(p.category),
          brandSlug: p.brandSlug,
          brandTitle: brandFull || p.brandSlug,
          brandName: p.brand || brandFull || p.brandSlug,
        },
      };
    });

  return paths.filter(
    (v, i, a) =>
      a.findIndex(
        (t) => t.params.category === v.params.category && t.params.brand === v.params.brand,
      ) === i,
  );
}

// ============ PROPS ============
const {
  mainCatTitle,
  mainCatSlug,
  categoryTitle,
  categorySlug,
  brandSlug,
  brandTitle,
  brandName,
} = Astro.props;

const brandProducts = getProductsByBrand(mainCatSlug, brandSlug) || [];
const firstProduct = brandProducts[0];
const heroImg = firstProduct?.photo?.[0] ? getProductImage(firstProduct.photo[0], 'technique') : null;
const isTall = mainCatSlug === 'lodochnye-motory';

const minPrice = brandProducts.length ? Math.min(...brandProducts.map((p: any) => p.price || Infinity)) : 0;
const maxPrice = brandProducts.length ? Math.max(...brandProducts.map((p: any) => p.price || 0)) : 0;
const subtitle = `${brandProducts.length} ${brandProducts.length === 1 ? 'модель' : brandProducts.length < 5 ? 'модели' : 'моделей'} ${brandName} в наличии. Цены от ${minPrice.toLocaleString()} ₽.`;

// ============ ФИЛЬТРЫ: КОНФИГУРАЦИЯ ПО КАТЕГОРИЯМ ============
const priceRanges = [
  { label: 'Все цены', v: '' },
  { label: 'до 250 000 ₽', v: '0-250000' },
  { label: '250 – 500 тыс ₽', v: '250000-500000' },
  { label: '500 – 750 тыс ₽', v: '500000-750000' },
  { label: '750 тыс – 1 млн ₽', v: '750000-1000000' },
  { label: '1 – 1,5 млн ₽', v: '1000000-1500000' },
  { label: '1,5 – 2 млн ₽', v: '1500000-2000000' },
  { label: '2 – 3 млн ₽', v: '2000000-3000000' },
  { label: 'от 3 млн ₽', v: '3000000-' },
];

const ccRanges = [
  { label: 'Все кубатуры', v: '' },
  { label: 'до 325 куб.см', v: '0-325' },
  { label: '350 – 625 куб.см', v: '350-625' },
  { label: '650 куб.см', v: '650-650' },
  { label: '800 – 850 куб.см', v: '800-850' },
  { label: 'от 1000 куб.см', v: '1000-' },
];

const tactFilters = [{ label: 'Тактность (все)', v: '' }, { label: '2-тактный', v: '2' }, { label: '4-тактный', v: '4' }];
const powerRanges = [
  { label: 'Мощность (все)', v: '' },
  { label: 'до 5 л.с.', v: '0-5' },
  { label: '6 – 9,8 л.с.', v: '6-9.8' },
  { label: '9,9 – 20 л.с.', v: '9.9-20' },
  { label: '25 – 30 л.с.', v: '25-30' },
  { label: '40 – 60 л.с.', v: '40-60' },
  { label: '70 – 130 л.с.', v: '70-130' },
  { label: '150 – 249 л.с.', v: '150-249' },
  { label: 'от 250 л.с.', v: '250-' },
];
const controlFilters = [{ label: 'Управление (все)', v: '' }, { label: 'Румпель', v: 'rumpel' }, { label: 'Дистанция', v: 'distance' }];
const propulsionFilters = [{ label: 'Движитель (все)', v: '' }, { label: 'Винтовой', v: 'screw' }, { label: 'Джет (водомет)', v: 'jet' }];

const trackFilters = [{ label: 'Ширина гусеницы (все)', v: '' }, { label: 'до 508 мм', v: '0-508' }, { label: 'от 509 мм', v: '509-' }];

const boatTypeFilters = [{ label: 'Тип лодки (все)', v: '' }, { label: 'Килевая', v: 'kilevaya' }, { label: 'Тоннельная', v: 'tonnelnaya' }, { label: 'RIB (жесткий корпус)', v: 'rib' }];
const floorTypeFilters = [{ label: 'Тип днища (все)', v: '' }, { label: 'Фанерная слань', v: 'fanera' }, { label: 'Алюминиевая слань', v: 'aluminum' }, { label: 'Надувное дно (AirDeck)', v: 'air' }];

// ============ ЧТЕНИЕ URL ПАРАМЕТРОВ (3 FALLBACK по Astro v7 docs) ============
// ✨ Официально: Astro v7 SSG dev-mode = Astro.url.search ИНОГДА пустой!
// ПОЭТОМУ fallback: 1) Astro.request.url (новый API v7, всегда ок) → 2) Astro.url.searchParams → 3) Astro.url.search
var qsRaw = '';
try {
  if (typeof Astro.request !== 'undefined' && Astro.request && Astro.request.url) {
    var u1 = String(Astro.request.url);
    var qm1 = u1.indexOf('?');
    if (qm1 >= 0) qsRaw = u1.substring(qm1);
  }
} catch (e) {}
if (!qsRaw && typeof Astro.url !== 'undefined' && Astro.url) {
  try {
    // fallback 2: searchParams (иногда работает даже если search пустой)
    var params = [];
    if (Astro.url.searchParams && Astro.url.searchParams.forEach) {
      Astro.url.searchParams.forEach(function (v, k) { params.push(k + '=' + encodeURIComponent(v)); });
      if (params.length > 0) qsRaw = '?' + params.join('&');
    }
    // fallback 3: Astro.url.search (последний шанс)
    if (!qsRaw && Astro.url.search) qsRaw = Astro.url.search;
  } catch (e2) {}
}
// ✨ ULTRA-DIAG в терминал — ЧТО БЫЛО ПРОЧИТАНО!
console.log('');
console.log('🚨🚨🚨 [URL READ DIAG] 3 sources:');
console.log('🚨🚨🚨   Astro.request.url result: qsRaw = [' + qsRaw + ']');
try { if (typeof Astro.url !== 'undefined' && Astro.url) console.log('🚨🚨🚨   Astro.url.search = [' + Astro.url.search + ']   Astro.url.href = [' + Astro.url.href + ']'); } catch (e) {}
console.log('🚨🚨🚨 [/URL READ DIAG]');

var qpPrice = getQueryParam('price', qsRaw);
var qpCC = getQueryParam('cc', qsRaw);
var qpTact = getQueryParam('tact', qsRaw);
var qpPower = getQueryParam('power', qsRaw);
var qpControl = getQueryParam('ctl', qsRaw);
var qpPropulsion = getQueryParam('prop', qsRaw);
var qpTrack = getQueryParam('track', qsRaw);
var qpBoatType = getQueryParam('bt', qsRaw);
var qpFloorType = getQueryParam('ft', qsRaw);

// ═══════════════════════════════════════════════════════════════
// ⭐ УСИЛЕННАЯ VAL(): ищет поле в 5 местах (как valueOf в [model].astro)
// ═══════════════════════════════════════════════════════════════
var RU_FALLBACK = {
  engine_cc: ['Объем двигателя, см³','Объем двигателя см³','Объем двигателя','Рабочий объем','Двигатель объем'],
  tact: ['Тактность','Число тактов','Тактный'],
  power_hp: ['Мощность, л.с.','Максимальная мощность','Мощность л.с.','Мощность (л.с.)','Максимальная мощность, л.с.'],
  track_width_mm: ['Ширина гусеницы, мм','Ширина гусеницы'],
  boat_type: ['Тип лодки','Тип'],
  floor_type: ['Тип днища','Тип слань','Тип пола'],
  control_type: ['Система управления','Тип управления','Управление'],
  propulsion: ['Тип движителя','Движитель','Тип подвесного мотора','Винт/Джет'],
};
function val(pr, k) {
  if (!pr || !k) return undefined;
  // 1) корень + filters
  var v = (pr[k] !== undefined && pr[k] !== null) ? pr[k] : (pr.filters && pr.filters[k] !== undefined ? pr.filters[k] : undefined);
  if (v !== undefined && v !== null && String(v).trim() !== '') return v;
  // 2) characteristics по ТОЧНОМУ англ ключу / char_*
  if (pr.characteristics) {
    var cv = pr.characteristics[k];
    if (cv !== undefined && cv !== null && String(cv).trim() !== '') return cv;
    cv = pr.characteristics['char_' + k];
    if (cv !== undefined && cv !== null && String(cv).trim() !== '') return cv;
    // 3) characteristics по РУССКИМ синонимам
    var rus = RU_FALLBACK[k] || [];
    var kClean = cleanKey(k);
    var keys = Object.keys(pr.characteristics);
    for (var idx = 0; idx < keys.length; idx++) {
      var ck = keys[idx];
      var cv2 = pr.characteristics[ck];
      if (cv2 === undefined || cv2 === null || String(cv2).trim() === '') continue;
      var ckClean = cleanKey(ck);
      if (ckClean === kClean) return cv2;
      for (var j = 0; j < rus.length; j++) {
        if (cleanKey(rus[j]) === ckClean) return cv2;
      }
    }
  }
  return undefined;
}

// ═══════════════════════════════════════════════════════════════════════
// ✨ Astro Best Practice for SSG + query params:
// Сервер РЕНДЕРИТ ВСЕ ТОВАРЫ (без фильтров!). Клиентский script читает
// window.location.search (ВСЕГДА АКТУАЛЬНЫЙ!) и прячет карточки через
// CSS display:none. + .active класс на кнопки фильтров.
// ═══════════════════════════════════════════════════════════════════════
var filtered = brandProducts; // ВСЕГДА ВСЕ (фильтр на клиенте!)
// Массив data-значений для каждой карточки (передаем в template через data-* атрибуты)
var productsFilterData = [];
for (var pfi = 0; pfi < brandProducts.length; pfi++) {
  var pfp = brandProducts[pfi];
  productsFilterData.push({
    price: pfp.price ?? 0,
    engine_cc: val(pfp, 'engine_cc') ?? '',
    tact: val(pfp, 'tact') ?? '',
    power_hp: val(pfp, 'power_hp') ?? '',
    track_width_mm: val(pfp, 'track_width_mm') ?? '',
    boat_type: val(pfp, 'boat_type') ?? '',
    floor_type: val(pfp, 'floor_type') ?? '',
    control_type: val(pfp, 'control_type') ?? '',
    propulsion: val(pfp, 'propulsion') ?? '',
  });
}

// ============ ✨ SSR ДИАГНОСТИКА ФИЛЬТРОВ (в ТЕРМИНАЛЕ!) ============
const qpAll = { price: qpPrice, cc: qpCC, tact: qpTact, power: qpPower, ctl: qpControl, prop: qpPropulsion, track: qpTrack, bt: qpBoatType, ft: qpFloorType };
const qpActive = Object.fromEntries(Object.entries(qpAll).filter(([,v]) => String(v).trim() !== ''));
console.log('');
console.log('╔══════════════════════════════════════════════════════════════════════╗');
console.log(`║ 🔍 FILTER DIAGNOSTIC | ${mainCatSlug.padEnd(18)} | ${brandTitle.substring(0, 35).padEnd(35)} ║`);
console.log('╠══════════════════════════════════════════════════════════════════════╣');
console.log(`║ URL query (активные): ${JSON.stringify(qpActive).padEnd(51)} ║`);
console.log(`║ Всего товаров: ${String(brandProducts.length).padEnd(6)} | После фильтра: ${String(filtered.length).padEnd(6)} | Разница: ${String(brandProducts.length - filtered.length).padEnd(6)} ║`);
console.log('╠════╤════════════════════════════════════════════╤════════╤══════╤══════╤══════╤══════════════╤══════════════╤════════╤══════════╗');
console.log('║  # │ Название (первые 40 симв.)                │ Цена ₽ │ CC   │ Tаct │ HP   │ Track_mm     │ Boat_type    │ Floor  │ Control  ║');
console.log('╟────┼────────────────────────────────────────────┼────────┼──────┼──────┼──────┼──────────────┼──────────────┼────────┼──────────╢');
brandProducts.slice(0, 24).forEach((pr, idx) => {
  const title = (pr.title || '').substring(0, 40).padEnd(40);
  const price = String((pr.price ?? 0)).padEnd(6).substring(0, 6);
  const pcc = String(val(pr, 'engine_cc') ?? '—').padEnd(4).substring(0, 4);
  const ptact = String(val(pr, 'tact') ?? '—').padEnd(4).substring(0, 4);
  const php = String(val(pr, 'power_hp') ?? '—').padEnd(4).substring(0, 4);
  const ptrack = String(val(pr, 'track_width_mm') ?? '—').padEnd(12).substring(0, 12);
  const pbtype = String(val(pr, 'boat_type') ?? '—').padEnd(12).substring(0, 12);
  const pftype = String(val(pr, 'floor_type') ?? '—').padEnd(6).substring(0, 6);
  const pctl = String(val(pr, 'control_type') ?? '—').padEnd(8).substring(0, 8);
  const i = String(idx + 1).padStart(2);
  console.log(`║ ${i} │ ${title} │ ${price} │ ${pcc} │ ${ptact} │ ${php} │ ${ptrack} │ ${pbtype} │ ${pftype} │ ${pctl} ║`);
});
if (brandProducts.length > 24) console.log(`║ .. │ + еще ${brandProducts.length - 24} товаров (показаны первые 24)...                       ║`);
console.log('╚════╧════════════════════════════════════════════╧════════╧══════╧══════╧══════╧══════════════╧══════════════╧════════╧══════════╝');
console.log('');
// ============ ФИЛЬТРАЦИЯ ИНДИВИДУАЛЬНО (показываем ПОЧЕМУ товар УБРАН):
if (brandProducts.length !== filtered.length && Object.keys(qpActive).length > 0) {
  console.log('🚨 ТОВАРЫ, КОТОРЫЕ ОТФИЛЬТРОВАНЫ (не попали в результат):');
  const filteredSet = new Set(filtered.map(p => String(p.title || '')));
  brandProducts.forEach(pr => {
    if (filteredSet.has(String(pr.title || ''))) return;
    const reasons = [];
    if (qpPrice && !inRange(pr.price, qpPrice)) reasons.push(`price=${pr.price} не в [${qpPrice}]`);
    if (qpCC && mainCatSlug === 'kvadrocikly' && !inRange(val(pr, 'engine_cc'), qpCC)) reasons.push(`engine_cc=${String(val(pr, 'engine_cc'))} не в [${qpCC}]`);
    if (qpTact && (mainCatSlug === 'lodochnye-motory' || mainCatSlug === 'snegohody') && normTact(val(pr, 'tact')) !== qpTact) reasons.push(`tact=${String(val(pr, 'tact'))} норм=${normTact(val(pr, 'tact'))} != ${qpTact}`);
    if (qpPower && mainCatSlug === 'lodochnye-motory' && !inRange(val(pr, 'power_hp'), qpPower)) reasons.push(`power_hp=${String(val(pr, 'power_hp'))} не в [${qpPower}]`);
    if (qpTrack && mainCatSlug === 'snegohody' && !inRange(val(pr, 'track_width_mm'), qpTrack)) reasons.push(`track_width_mm=${String(val(pr, 'track_width_mm'))} не в [${qpTrack}]`);
    if (qpBoatType && mainCatSlug === 'lodki' && normBoatType(val(pr, 'boat_type')) !== qpBoatType) reasons.push(`boat_type=${String(val(pr, 'boat_type'))} норм=${normBoatType(val(pr, 'boat_type'))} != ${qpBoatType}`);
    if (qpFloorType && mainCatSlug === 'lodki' && normFloorType(val(pr, 'floor_type')) !== qpFloorType) reasons.push(`floor_type=${String(val(pr, 'floor_type'))} норм=${normFloorType(val(pr, 'floor_type'))} != ${qpFloorType}`);
    if (qpControl && mainCatSlug === 'lodochnye-motory' && normControl(val(pr, 'control_type')) !== qpControl) reasons.push(`control=${String(val(pr, 'control_type'))} норм=${normControl(val(pr, 'control_type'))} != ${qpControl}`);
    if (qpPropulsion && mainCatSlug === 'lodochnye-motory' && normPropulsion(val(pr, 'propulsion')) !== qpPropulsion) reasons.push(`propulsion=${String(val(pr, 'propulsion'))} норм=${normPropulsion(val(pr, 'propulsion'))} != ${qpPropulsion}`);
    console.log(`   ❌ [${pr.title?.substring(0, 55)}] → причины: ${reasons.join(', ') || 'НЕИЗВЕСТНО?'}`);
  });
  console.log('══════════════════════════════════════════════════════════════════');
}

function link(params: Record<string, string>): string {
  const sp = new URLSearchParams(Astro.url.searchParams);
  for (const [k, v] of Object.entries(params)) {
    if (!v) sp.delete(k); else sp.set(k, v);
  }
  const qs = sp.toString();
  return qs ? `?${qs}` : `#`;
}
function anyFilterActive(): boolean {
  return !!(qpPrice || qpCC || qpTact || qpPower || qpControl || qpPropulsion || qpTrack || qpBoatType || qpFloorType);
}

const layoutClass = brandProducts.length > 0 ? 'layout-with-filters' : '';---

<Layout title={`${brandTitle} — купить в Красноярске по цене от ${minPrice.toLocaleString()} ₽`} description={subtitle} heroImage={heroImg} heroSubtitle={subtitle}>
  <div class="container container--py">
    <nav class="breadcrumb">
      <a href={u("/")}>Главная</a> /
      <a href={u("/catalog")}>Каталог</a> /
      <a href={`/catalog/${mainCatSlug}`}>{mainCatTitle}</a> /
      <span>{brandTitle}</span>
    </nav>

    <div class="title-row">
      <h1 class="page-title">{brandTitle} — {brandProducts.length} {brandProducts.length === 1 ? 'модель' : brandProducts.length < 5 ? 'модели' : 'моделей'}</h1>
      {anyFilterActive() && (
        <a href={`/catalog/${mainCatSlug}/${brandSlug}`} class="reset-btn">Сбросить все фильтры</a>
      )}
    </div>
    <p class="subtitle-small">{subtitle}</p>

    {brandProducts.length === 0 ? (
      <div class="empty"><p>Товаров пока нет. Скоро появятся.</p></div>
    ) : (
      <div class={`shop-layout ${layoutClass}`}>

        {/* ============ ФИЛЬТРЫ СЛЕВА ============ */}
        <aside class="filter-sidebar">
          <div class="filter-block">
            <h3 class="filter-title">Цена</h3>
            <div class="filter-list">
              {priceRanges.map((r) => (
                <a href={link({ price: r.v })} class={`filter-item ${r.v === qpPrice ? 'active' : ''}`}>{r.label}</a>
              ))}
            </div>
          </div>

          {mainCatSlug === 'kvadrocikly' && (
            <div class="filter-block">
              <h3 class="filter-title">Объем двигателя</h3>
              <div class="filter-list">
                {ccRanges.map((r) => (
                  <a href={link({ cc: r.v })} class={`filter-item ${r.v === qpCC ? 'active' : ''}`}>{r.label}</a>
                ))}
              </div>
            </div>
          )}

          {mainCatSlug === 'lodochnye-motory' && (<>
            <div class="filter-block">
              <h3 class="filter-title">Тактность</h3>
              <div class="filter-list">
                {tactFilters.map((r) => (
                  <a href={link({ tact: r.v })} class={`filter-item ${r.v === qpTact ? 'active' : ''}`}>{r.label}</a>
                ))}
              </div>
            </div>
            <div class="filter-block">
              <h3 class="filter-title">Мощность (л.с.)</h3>
              <div class="filter-list">
                {powerRanges.map((r) => (
                  <a href={link({ power: r.v })} class={`filter-item ${r.v === qpPower ? 'active' : ''}`}>{r.label}</a>
                ))}
              </div>
            </div>
            <div class="filter-block">
              <h3 class="filter-title">Управление</h3>
              <div class="filter-list">
                {controlFilters.map((r) => (
                  <a href={link({ ctl: r.v })} class={`filter-item ${r.v === qpControl ? 'active' : ''}`}>{r.label}</a>
                ))}
              </div>
            </div>
            <div class="filter-block">
              <h3 class="filter-title">Движитель</h3>
              <div class="filter-list">
                {propulsionFilters.map((r) => (
                  <a href={link({ prop: r.v })} class={`filter-item ${r.v === qpPropulsion ? 'active' : ''}`}>{r.label}</a>
                ))}
              </div>
            </div>
          </>)}

          {mainCatSlug === 'snegohody' && (<>
            <div class="filter-block">
              <h3 class="filter-title">Тактность</h3>
              <div class="filter-list">
                {tactFilters.map((r) => (
                  <a href={link({ tact: r.v })} class={`filter-item ${r.v === qpTact ? 'active' : ''}`}>{r.label}</a>
                ))}
              </div>
            </div>
            <div class="filter-block">
              <h3 class="filter-title">Ширина гусеницы</h3>
              <div class="filter-list">
                {trackFilters.map((r) => (
                  <a href={link({ track: r.v })} class={`filter-item ${r.v === qpTrack ? 'active' : ''}`}>{r.label}</a>
                ))}
              </div>
            </div>
          </>)}

          {mainCatSlug === 'lodki' && (<>
            <div class="filter-block">
              <h3 class="filter-title">Тип лодки</h3>
              <div class="filter-list">
                {boatTypeFilters.map((r) => (
                  <a href={link({ bt: r.v })} class={`filter-item ${r.v === qpBoatType ? 'active' : ''}`}>{r.label}</a>
                ))}
              </div>
            </div>
            <div class="filter-block">
              <h3 class="filter-title">Тип днища</h3>
              <div class="filter-list">
                {floorTypeFilters.map((r) => (
                  <a href={link({ ft: r.v })} class={`filter-item ${r.v === qpFloorType ? 'active' : ''}`}>{r.label}</a>
                ))}
              </div>
            </div>
          </>)}

          <div class="filter-summary">
            Найдено: <b>{filtered.length}</b> {filtered.length === 1 ? 'модель' : filtered.length < 5 ? 'модели' : 'моделей'}
          </div>
        </aside>

        {/* ============ ТОВАРЫ СПРАВА ============ */}
        <main class="products-main">
          {filtered.length === 0 ? (
            <div class="empty">
              <p>Ни одного товара не подошло по выбранным фильтрам.</p>
              <a href={`/catalog/${mainCatSlug}/${brandSlug}`} class="reset">Сбросить фильтры</a>
            </div>
          ) : (
            <div class={`grid-3col ${isTall ? 'grid--tall' : ''}`}>
              {filtered.map((product, cardIndex) => {
                const imgSrc = product.photo?.[0];
                const optimizedImg = getProductImage(imgSrc, 'technique');
                const fdata = productsFilterData[cardIndex] || {};
                return (
                  <a
                    href={`/catalog/${mainCatSlug}/${product.brandSlug}/${product.modelSlug}`}
                    class="card product-card"
                    data-price={fdata.price ?? ''}
                    data-engine-cc={fdata.engine_cc ?? ''}
                    data-tact={fdata.tact ?? ''}
                    data-power-hp={fdata.power_hp ?? ''}
                    data-track-width-mm={fdata.track_width_mm ?? ''}
                    data-boat-type={fdata.boat_type ?? ''}
                    data-floor-type={fdata.floor_type ?? ''}
                    data-control-type={fdata.control_type ?? ''}
                    data-propulsion={fdata.propulsion ?? ''}
                  >
                    <div class={`card__img ${isTall ? 'card__img--tall' : ''}`}>
                      {optimizedImg ? (
                        <Image
                          src={optimizedImg}
                          alt={product.title}
                          width={500}
                          height={isTall ? 667 : 375}
                          fit="contain"
                          loading="lazy"
                          decoding="async"
                          format="webp"
                          quality={85}
                        />
                      ) : (
                        <img src={imgSrc || '/placeholder.jpg'} alt={product.title} loading="lazy" />
                      )}
                    </div>

                    {product.quantity !== undefined && product.quantity !== null && (
                      <span class={`badge ${product.quantity > 0 ? 'in-stock' : 'out-of-stock'}`}>
                        {product.quantity > 0 ? `В наличии: ${product.quantity}` : 'Под заказ'}
                      </span>
                    )}

                    <div class="card__body">
                      <h3>{product.title}</h3>
                      {product.article && <span class="art">Арт. {product.article}</span>}
                      <div class="card__price-row">
                        <span class="price">{product.price?.toLocaleString('ru-RU') || 'Цену уточняйте'} ₽</span>
                      </div>
                      <button type="button" class="card__cta">Подробнее →</button>
                    </div>
                  </a>
                );
              })}
            </div>
          )}
        </main>
      </div>
    )}
  </div>
</Layout>

<meta name="maincatslug" content={mainCatSlug} />

<script type="module">
  // ══════════════════════════════════════════════════════════════════
  // ✨ Astro Best Practice: SSG + query params = FILTER ON CLIENT!
  // window.location.search всегда актуальный (100% на любом браузере / ОС).
  // ══════════════════════════════════════════════════════════════════
  const mainCatSlugClient = (document.querySelector('meta[name="maincatslug"]')?.content) || '';
  const _qs = window.location.search || '';

  function _qp(name, qs) {
    let q = qs;
    if (!q) return '';
    if (q.charAt(0) === '?') q = q.substring(1);
    if (!q) return '';
    let i = 0, start = 0;
    while (i <= q.length) {
      const amp = q.indexOf('&', i);
      const end = amp < 0 ? q.length : amp;
      if (end >= start) {
        const pair = q.substring(start, end);
        if (pair.length > 0) {
          const eqAt = pair.indexOf('=');
          const k = eqAt < 0 ? pair : pair.substring(0, eqAt);
          if (k === name) {
            let v = eqAt < 0 ? '' : pair.substring(eqAt + 1);
            let out = '';
            for (let jj = 0; jj < v.length; jj++) {
              const ch = v.charAt(jj);
              out += ch === '+' ? ' ' : ch;
            }
            try { out = decodeURIComponent(out); } catch (e) {}
            return out;
          }
        }
      }
      if (amp < 0) break;
      i = amp + 1; start = i;
    }
    return '';
  }
  function _inRange(valRaw, range) {
    if (!range) return true;
    if (valRaw === undefined || valRaw === null) return false;
    const rawS = String(valRaw);
    let s = '';
    for (let i = 0; i < rawS.length; i++) {
      const c = rawS.charAt(i); const code = rawS.charCodeAt(i);
      if (code === 44) s += '.';
      else if (code === 46 || code === 45 || (code >= 48 && code <= 57)) s += c;
    }
    if (!s) return false;
    const num = parseFloat(s); if (isNaN(num)) return false;
    if (range.charAt(0) === '-') { const b = parseFloat(range.substring(1)); return !isNaN(b) && num <= b; }
    if (range.charAt(range.length - 1) === '-') { const a = parseFloat(range.substring(0, range.length - 1)); return !isNaN(a) && num >= a; }
    const dashAt = range.indexOf('-'); if (dashAt < 0) return false;
    const a = parseFloat(range.substring(0, dashAt)); const b = parseFloat(range.substring(dashAt + 1));
    return !isNaN(a) && !isNaN(b) && num >= a && num <= b;
  }
  function _onlyAlnum(s) {
    if (!s) return ''; const raw = String(s);
    let out = '';
    for (let i = 0; i < raw.length; i++) {
      const c = raw.charAt(i); const code = raw.charCodeAt(i);
      if ((code >= 48 && code <= 57) || (code >= 65 && code <= 90) || (code >= 97 && code <= 122) ||
          (code >= 0x0410 && code <= 0x044F) || code === 0x0401 || code === 0x0451) out += c;
    }
    return out.toLowerCase();
  }
  function _normTact(s) { if (s === undefined || s === null) return undefined; const x = _onlyAlnum(String(s)); if (x === '2' || x.startsWith('2такт') || x === 'two') return '2'; if (x === '4' || x.startsWith('4такт') || x === 'four') return '4'; return undefined; }
  function _normControl(s) { if (s === undefined || s === null) return undefined; const x = _onlyAlnum(String(s)); if (x.startsWith('rum') || x.startsWith('румп') || x === 'rumpel') return 'rumpel'; if (x.startsWith('dist') || x.startsWith('дист') || x.startsWith('пулт') || x === 'distance') return 'distance'; return undefined; }
  function _normProp(s) { if (s === undefined || s === null) return undefined; const x = _onlyAlnum(String(s)); if (x.includes('vint') || x.includes('винт') || x === 'screw') return 'screw'; if (x.includes('jet') || x.includes('дж') || x.includes('водом') || x === 'jet') return 'jet'; return undefined; }
  function _normBoat(s) { if (s === undefined || s === null) return undefined; const x = _onlyAlnum(String(s)); if (x.includes('кил') || x === 'kilevaya') return 'kilevaya'; if (x.includes('тоннел') || x === 'tonnelnaya') return 'tonnelnaya'; if (x.includes('rib') || x.includes('риб')) return 'rib'; return undefined; }
  function _normFloor(s) { if (s === undefined || s === null) return undefined; const x = _onlyAlnum(String(s)); if (x.includes('фанер') || x === 'fanera') return 'fanera'; if (x.includes('алюм') || x === 'aluminum') return 'aluminum'; if (x.includes('надув') || x.includes('air') || x === 'air') return 'air'; return undefined; }

  // ============ ПРИМЕНЯЕМ ФИЛЬТР (НА КЛИЕНТЕ!) ============
  const qp = {
    price: _qp('price', _qs),
    cc: _qp('cc', _qs),
    tact: _qp('tact', _qs),
    power: _qp('power', _qs),
    ctl: _qp('ctl', _qs),
    prop: _qp('prop', _qs),
    track: _qp('track', _qs),
    bt: _qp('bt', _qs),
    ft: _qp('ft', _qs),
  };
  console.log('[CLIENT FILTER] ✨ window.location.search =', _qs, '  qp =', qp, '  mainCatSlug=', mainCatSlugClient);
  let passedCount = 0, totalCount = 0;
  document.querySelectorAll('.product-card').forEach((card) => {
    totalCount++;
    const p = Number(card.getAttribute('data-price'));
    const cc = card.getAttribute('data-engine-cc');
    const tact = card.getAttribute('data-tact');
    const hp = card.getAttribute('data-power-hp');
    const trackMm = card.getAttribute('data-track-width-mm');
    const boatT = card.getAttribute('data-boat-type');
    const floorT = card.getAttribute('data-floor-type');
    const ctlT = card.getAttribute('data-control-type');
    const propT = card.getAttribute('data-propulsion');
    let show = true;
    if (qp.price && !_inRange(p, qp.price)) show = false;
    if (show && mainCatSlugClient === 'kvadrocikly' && qp.cc && !_inRange(cc, qp.cc)) show = false;
    if (show && mainCatSlugClient === 'kvadrocikly' && qp.tact && _normTact(tact) !== qp.tact) show = false;
    if (show && mainCatSlugClient === 'lodochnye-motory') {
      if (qp.tact && _normTact(tact) !== qp.tact) show = false;
      if (show && qp.power && !_inRange(hp, qp.power)) show = false;
      if (show && qp.ctl && _normControl(ctlT) !== qp.ctl) show = false;
      if (show && qp.prop && _normProp(propT) !== qp.prop) show = false;
    }
    if (show && mainCatSlugClient === 'snegohody') {
      if (qp.tact && _normTact(tact) !== qp.tact) show = false;
      if (show && qp.track && !_inRange(trackMm, qp.track)) show = false;
    }
    if (show && mainCatSlugClient === 'lodki') {
      if (qp.bt && _normBoat(boatT) !== qp.bt) show = false;
      if (show && qp.ft && _normFloor(floorT) !== qp.ft) show = false;
    }
    if (show) { passedCount++; card.style.removeProperty('display'); }
    else card.style.setProperty('display', 'none', 'important');
  });
  // Empty state (класс = .empty!)
  const emptyBlock = document.querySelector('.empty');
  const gridBlock = document.querySelector('.grid-3col');
  if (emptyBlock && gridBlock) {
    if (passedCount === 0 && totalCount > 0) { emptyBlock.style.removeProperty('display'); gridBlock.style.setProperty('display','none'); }
    else { emptyBlock.style.setProperty('display','none'); gridBlock.style.removeProperty('display'); }
  }
  const resCount = document.querySelector('.result-count');
  if (resCount) resCount.textContent = String(passedCount);

  // ============ ПОДСВЕТКА АКТИВНОСТИ КНОПОК ФИЛЬТРОВ ============
  const filterSidebar = document.querySelector('.filter-sidebar');
  if (filterSidebar) {
    filterSidebar.querySelectorAll('.filter-list').forEach((listBlock) => {
      const links = listBlock.querySelectorAll('a.filter-item');
      links.forEach((a) => {
        const href = a.getAttribute('href') || '';
        const qm = href.indexOf('?');
        let onlyQ = qm >= 0 ? href.substring(qm) : href;
        let active = false;
        const params = ['price','cc','tact','power','ctl','prop','track','bt','ft'];
        for (let pi = 0; pi < params.length; pi++) {
          const pv = _qp(params[pi], onlyQ);
          if (pv !== '' && _qp(params[pi], _qs) === pv) { active = true; break; }
        }
        let allEmpty = true;
        for (let pi2 = 0; pi2 < params.length; pi2++) {
          if (_qp(params[pi2], onlyQ) !== '') allEmpty = false;
        }
        const curAny = Object.values(qp).some(vv => vv !== '');
        if (allEmpty && !curAny) active = true;
        a.classList.toggle('active', active);
      });
    });
  }
  console.log('[CLIENT FILTER] ✅ Готово! Показано товаров:', passedCount, '/', totalCount);
</script>

