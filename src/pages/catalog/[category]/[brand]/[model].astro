<script>
/* ⚡ Vanilla JS — галерея thumbnails + modal */
document.addEventListener('DOMContentLoaded', () => {
  // --- Thumbnails ---
  const wrap = document.getElementById('thumbsWrap') as HTMLDivElement | null;
  const mainImg = document.getElementById('mainImage') as HTMLImageElement | null;
  if (wrap && mainImg) {
    wrap.querySelectorAll('.thumb-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const anyBtn = btn as any;
        const idx = Number(anyBtn.dataset.idx || '0');
        const allThumbs = wrap.querySelectorAll<HTMLButtonElement>('.thumb-btn');
        const clickedBtn = allThumbs[idx];
        if (!clickedBtn) return;
        allThumbs.forEach(b => b.classList.remove('active'));
        clickedBtn.classList.add('active');

        const innerImg = clickedBtn.querySelector('img');
        if (!innerImg) return;
        // Копируем все src/sizes/data с thumb
        for (const attr of ['src', 'srcset', 'sizes', 'alt', 'width', 'height']) {
          const v = innerImg.getAttribute(attr);
          if (v) mainImg.setAttribute(attr, v);
        }
        // Astro Image data attributes
        for (const attr of innerImg.getAttributeNames()) {
          if (attr.startsWith('data-')) {
            const v = innerImg.getAttribute(attr);
            if (v) mainImg.setAttribute(attr, v);
          }
        }
        mainImg.removeAttribute('loading');
        mainImg.style.opacity = '0.55';
        setTimeout(() => { mainImg.style.opacity = ''; }, 80);
      });
    });
  }

  // --- Modal ---
  const modal = document.getElementById('contactModal') as HTMLDivElement | null;
  const openBtn = document.getElementById('contact-btn');
  const shut = () => { if (modal) { modal.setAttribute('aria-hidden', 'true'); document.body.style.overflow = ''; } };
  const open = () => { if (modal) { modal.setAttribute('aria-hidden', 'false'); document.body.style.overflow = 'hidden'; } };
  if (openBtn) openBtn.addEventListener('click', open);
  const form = document.getElementById('contactForm') as HTMLFormElement | null;
  modal?.addEventListener('click', (e) => { if ((e.target as Element).hasAttribute('data-close')) shut(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') shut(); });
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    // TODO: здесь подключить реальную отправку на почту / Telegram API / Formspree
    alert('Спасибо! Ваша заявка принята. Менеджер свяжется с вами в течение 15 минут.');
    shut();
  });
});
</script>