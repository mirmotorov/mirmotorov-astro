---
import Layout from '../../../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getAllProducts } from '../../../../utils/load-products';
import { getProductImage } from '../../../../utils/image-loader';
import { categoryToSlug, getMainCategory } from '../../../../utils/transliterate';

export function getStaticPaths() {
  return getAllProducts()
    .filter((p) => p.brandSlug && p.modelSlug && p.category)
    .map((product) => ({
      params: {
        category: categoryToSlug(product.category),
        brand: product.brandSlug,
        model: product.modelSlug,
      },
      props: { product },
    }));
}

const { product } = Astro.props;
const mainCat = getMainCategory(product.category) || '';
const mainCatSlug = categoryToSlug(mainCat);
const categorySlug = categoryToSlug(product.category);
const pageTitle = product.seo?.title || `${product.title} — купить в Красноярске`;
const pageDescription = product.seo?.description || product.description || `Купить ${product.title} в Красноярске. Официальный дилер, гарантия, доставка.`;

// Все фото товара. ⚠️ БЕЗ TypeScript-типов (баг Rolldown в Astro 7 Win)
const photos = [];
const productPhotos = Array.isArray(product.photo) ? product.photo.slice() : [];
for (let k = 0; k < productPhotos.length; k++) {
  const s = String(productPhotos[k] || '').trim();
  if (!s) continue;
  const bigImg = getProductImage(s, 'technique');
  const thumbImg = getProductImage(s, 'technique');
  photos.push({ rel: s, big: bigImg || s, thumb: thumbImg || s });
}
const firstPhoto = photos[0];

const allProducts = getAllProducts();
const mySlug = product.modelSlug || '';
const myRelated = product.relatedTags || [];
const related = [];
for (const p of allProducts) {
  if (p.modelSlug === mySlug) continue;
  const theirSlug = p.modelSlug || '';
  const theirTags = p.relatedTags || [];
  const match1 = theirTags.includes(mySlug);
  const match2 = myRelated.includes(theirSlug);
  if (match1 || match2) related.push(p);
  if (related.length >= 12) break;
}

const isTall = mainCatSlug === 'lodochnye-motory';
const price = product.price || 0;
const oldPrice = product.oldPrice || null;
const priceVatOnly = price > 0 ? Math.round(price / 1.22 * 0.22) : 0;
const priceNoVat = price > 0 ? Math.round(price / 1.22) : 0;
const fullText = product.full_text || product.text || product.long_description || product.description || '';

// ============== ⭐⭐⭐ СУПЕР-УНИВЕРСАЛЬНЫЙ getCharValue (2026-09-01) =============
// Ищет 8 СПОСОБАМИ: 1) product.KEY 2) product.filters.KEY 3) product.characteristics[KEY]
// 4) product.characteristics[char_KEY] 5) product.characteristics [ПО РУССКОМУ ИМЕНИ из маппинга]
// 6) По ТОЧНОМУ названию столбца 7) По очищенному имени (без пробелов, знаков, регистра)
// 8) По полям ВСЁ ЕЩЕ В product.characteristics по совпадению любого вида
const RU_CHAR_MAP = {
  engine_cc: 'Объем двигателя, см³', engine_type: 'Тип двигателя',
  engine_cc2: 'Объем двигателя, см³',
  max_power: 'Максимальная мощность, л.с.', power_hp: 'Максимальная мощность, л.с.',
  max_power_rpm: 'Максимальная мощность при об/мин', max_torque: 'Крутящий момент, Н·м',
  cylinders: 'Количество цилиндров',
  tact: 'Тактность',
  transmission: 'Коробка передач', gearbox: 'Коробка передач',
  drive: 'Привод', diff_lock: 'Блокировка дифференциала',
  front_susp: 'Передняя подвеска', rear_susp: 'Задняя подвеска', shocks: 'Амортизаторы',
  tires: 'Шины', wheels: 'Диски колёс', wheels_disc: 'Диски колёс',
  steering: 'Рулевое управление',
  brakes: 'Тормозная система', front_brake_type: 'Передний тормоз', rear_brake_type: 'Задний тормоз',
  fuel_system: 'Система питания', fuel_tank: 'Топливный бак, л',
  cooling: 'Система охлаждения', ignition: 'Зажигание',
  starter: 'Стартер', battery: 'Аккумулятор',
  fuel_rec: 'Рекомендуемое топливо', fuel_cons: 'Расход топлива, л/ч',
  fuel_cons_l_h: 'Расход топлива, л/ч', rpm_range: 'Рабочие обороты, об/мин',
  track_width_mm: 'Ширина гусеницы, мм', caterpillar_len: 'Длина гусеницы, мм',
  ski_type: 'Тип лыж', ski_width_mm: 'Ширина лыжи, мм',
  control_type: 'Система управления', propulsion: 'Тип движителя',
  leg_len: 'Длина вала (ноги), дюймы', leg_len_in: 'Длина вала, дюймы',
  trim: 'Трим / материал баллона', cylinders_mat: 'Материал баллонов',
  tilt_angle: 'Угол наклона / фиксации', gear_ratio: 'Передаточное число редуктора',
  weight: 'Вес, кг', dimensions: 'Габариты Д×Ш×В, мм',
  length_width: 'Длина × ширина', length_cm: 'Длина, см', beam_width_cm: 'Ширина, см',
  wheelbase: 'Колёсная база, мм', ground_clearance: 'Дорожный просвет, мм',
  length_cm: 'Длина лодки, см', beam_width_cm: 'Ширина лодки по бортам, см',
  cockpit: 'Кокпит', cockpit_length_mm: 'Длина кокпита, мм', cockpit_width_mm: 'Ширина кокпита, мм',
  balloon_d: 'Диаметр баллона, см', balloons_qty: 'Количество воздушных отсеков, шт.',
  body_color: 'Цвет баллона', cockpit_color: 'Цвет кокпита / днища',
  boat_type: 'Тип лодки', floor_type: 'Тип днища / сланей',
  floor_material: 'Материал сланей',
  seats: 'Посадочные места, чел.', capacity: 'Грузоподъёмность, кг',
  load_capacity_kg: 'Грузоподъёмность, кг', capacity_pers: 'Пассажировместимость, чел.',
  max_hp: 'Максимальная мощность мотора, л.с.', max_weight_motor_kg: 'Максимальный вес мотора, кг',
  cabin_type: 'Тип кабины', doors: 'Количество дверей',
  heater: 'Отопитель', hvac: 'Вентиляция / кондиционер HVAC',
  lighting: 'Освещение', winch: 'Лебедка',
  body_type: 'Тип кузова', cargo: 'Грузоподъёмность кузова, кг',
  cargo_volume: 'Объём кузова, м³', dump_bed: 'Самосвальный кузов',
  towing: 'Буксировка прицепа, кг',
  max_speed: 'Максимальная скорость, км/ч',
  equipment: 'Комплектация',
  warranty: 'Гарантия', char_warranty: 'Гарантия',
  country_of_origin: 'Страна производства',
};
function cleanStr(s) {
  return (String(s || '')).toLowerCase().replace(/[^a-zа-я0-9]/gi, '');
}

// ============================================================
// ✅ 3 ИСТОЧНИКА: product + product.filters + product.characteristics
// ✅ ДУБЛИКАТЫ НЕ БУДУТ — мы используем ТОЧНЫЙ ЗАДАННЫЙ СПИСОК ПОЛЕЙ (не mergedKeys!)
// ============================================================
const mergedChars = { ...(product || {}), ...(product.filters || {}), ...(product.characteristics || {}) };
const mergedKeys = Object.keys(mergedChars);
const lenientMap = {};
mergedKeys.forEach((mk) => { lenientMap[cleanStr(mk)] = mk; });
function valueOf(key) {
  if (!key) return null;
  // 0. Дополнительно: столбцы csv с "неразрывным пробелом" в конце (trim , leg_len , fuel_tank )
  const altKeys = [key];
  if (key === 'trim') altKeys.push('trim ');
  if (key === 'leg_len') altKeys.push('leg_len ');
  if (key === 'fuel_tank') altKeys.push('fuel_tank ');
  if (key === 'equipment') altKeys.push('equipment ');
  // 1. Точное совпадение (включая альтернативные ключи с пробелом)
  let v = undefined;
  for (let ak = 0; ak < altKeys.length; ak++) {
    if (mergedChars[altKeys[ak]] !== undefined) { v = mergedChars[altKeys[ak]]; break; }
  }
  if (v !== undefined && v !== null && String(v).trim() !== '') return String(v);
  // 2. По русскому имени из RU_CHAR_MAP
  const ruName = RU_CHAR_MAP[key];
  if (ruName) {
    v = mergedChars[ruName];
    if (v !== undefined && v !== null && String(v).trim() !== '') return String(v);
  }
  // 3. По очищенному ключу
  const kClean = cleanStr(key);
  const hit = lenientMap[kClean];
  if (hit) {
    v = mergedChars[hit];
    if (v !== undefined && v !== null && String(v).trim() !== '') return String(v);
  }
  // 4. По очищенному русскому имени
  if (ruName) {
    const ruClean = cleanStr(ruName);
    const hitRu = lenientMap[ruClean];
    if (hitRu) {
      v = mergedChars[hitRu];
      if (v !== undefined && v !== null && String(v).trim() !== '') return String(v);
    }
  }
  // 5. Подстрока fallback
  const fallbackKey = mergedKeys.find((mk) => {
    const mkC = cleanStr(mk); if (!mkC) return false;
    return mkC.includes(kClean) || (ruName && mkC.includes(cleanStr(ruName)));
  });
  if (fallbackKey) {
    v = mergedChars[fallbackKey];
    if (v !== undefined && v !== null && String(v).trim() !== '') return String(v);
  }
  return null;
}

// ======= ⭐⭐⭐ ЛИНЕЙНЫЙ СПИСОК ТХ (ВАШЕ ТЗ — БЕЗ ГРУПП! ТОЧНЫЙ ПОРЯДОК) =======
