    ['length_width','Длина × ширина, мм'],
    ['wheelbase','Колёсная база, мм'],
    ['ground_clearance','Дорожный просвет, мм'],
    ['max_speed','Максимальная скорость, км/ч'],
    // 6) Комплектация + ГАРАНТИЯ (в самом конце!)
    ['equipment','Комплектация'],
