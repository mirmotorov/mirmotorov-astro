    ['ignition','Зажигание'],
    ['starter','Стартер'],
    ['battery','Аккумулятор'],
    ['fuel_tank','Топливный бак, л'],
    ['fuel_rec','Рекомендуемое топливо'],
    ['rpm_range','Рабочие обороты, об/мин'],
