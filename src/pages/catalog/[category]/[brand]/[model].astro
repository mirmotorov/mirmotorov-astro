    ['balloon_d','Диаметр баллона, см'],
    ['balloons_qty','Количество воздушных отсеков, шт.'],
    ['trim','Материал и плотность ПВХ, г/м²'],
    ['cylinders_mat','Материал баллонов'],
    ['body_color','Цвет баллона'],
    ['cockpit_color','Цвет кокпита'],
    // 4) Пассажиры, груз, вес
    ['seats','Посадочные места, чел.'],
