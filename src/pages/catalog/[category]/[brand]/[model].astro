    ['country_of_origin','Страна производства'],
  ],
  'lodochnye-motory': [
    // ✅ ВАШЕ ТЗ: в раздел Двигатель добавить Система управления + Тип движителя + Вес!
    ['engine_type','Тип двигателя'],
    ['engine_cc','Объём двигателя, см³'],
    ['tact','Тактность'],
    ['cylinders','Количество цилиндров'],
    ['power_hp','Мощность, л.с.'],
    ['fuel_system','Система питания'],
    ['cooling','Система охлаждения'],
    ['ignition','Зажигание'],
