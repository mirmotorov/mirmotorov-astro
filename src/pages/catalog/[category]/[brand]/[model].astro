    ['propulsion','Тип движителя'],
    ['weight','Вес, кг'],
    // Остальное как у всех
    ['transmission','Коробка / редуктор'],
    ['gear_ratio','Передаточное число редуктора'],
    ['leg_len','Длина вала (ноги), дюймы'],
    ['leg_len_in','Длина вала, дюймы'],
    ['tilt_angle','Угол наклона (фиксаций)'],
    ['trim','Трим (подъём / опускание)'],
    ['dimensions','Габариты Д×Ш×В, мм'],
    ['max_speed','Максимальная скорость с лодкой, км/ч'],
    ['equipment','Комплектация'],
    ['char_warranty','Гарантия'],
    ['warranty','Гарантия'],
    ['country_of_origin','Страна производства'],
  ],
};
function buildFlatChars(mainCat) {
  const rows = FLAT_CHARS[mainCat] || [];
  const seenKeys = {};
  const seenLabelVal = {};
  const out = [];
  for (let i = 0; i < rows.length; i++) {
    const k = rows[i][0]; const label = rows[i][1];
    const v = valueOf(k); if (!v) continue;
    if (seenKeys[k]) continue; // уже добавили
    const keyForDup = label + '@' + cleanStr(v);
    if (seenLabelVal[keyForDup]) continue; // дубликат по label+значению
    seenKeys[k] = true;
    seenLabelVal[keyForDup] = true;
    out.push([k, label, v]);
  }
  return out;
}
const finalCharList = buildFlatChars(mainCatSlug);
// ❗ ПРОЧИЕ ХАРАКТЕРИСТИКИ — УДАЛЕНЫ ПОЛНОСТЬЮ (100%)!
const hasChars = finalCharList.length > 0;

// Диагностика в F12 Console
if (typeof console !== 'undefined') {
  console.log('[ТХ] product.title =', product.title);
  console.log('[ТХ] mainCatSlug =', mainCatSlug);
  console.log('[ТХ] finalCharList (ВСЕГО СТРОК:', finalCharList.length, '):', finalCharList.map(r => r[1] + ' = ' + r[2]));
  console.log('[ТХ] valueOf(char_warranty) =', valueOf('char_warranty'));
  console.log('[ТХ] valueOf(engine_cc) =', valueOf('engine_cc'));
  console.log('[ТХ] valueOf(control_type) =', valueOf('control_type'), ' | propulsion=', valueOf('propulsion'));
}

// ====== Хлебные крошки ======
const breadcrumbs = [
  { href: '/', name: 'Главная' },
  { href: '/catalog', name: 'Каталог' },
  { href: `/catalog/${mainCatSlug}`, name: mainCat },
  { href: `/catalog/${mainCatSlug}/${product.brandSlug}`, name: product.brand || product.brandSlug },
  { href: null, name: product.title },
];
---

<Layout title={pageTitle} description={pageDescription}>
  <div class="container container--py">

    <nav class="breadcrumb">
      {breadcrumbs.map((b, i) => (
        <>
          {i > 0 && <span> / </span>}
          {b.href ? <a href={b.href}>{b.name}</a> : <span>{b.name}</span>}
        </>
      ))}
    </nav>

    <h1 class="page-h1">{product.title}</h1>

    {/* ============== 1) ГАЛЕРЕЯ (ЛЕВО) + ИНФО (ПРАВО) ============== */}
    <div class="product-top">
      {/* ===== ЛЕВО: галерея ===== */}
      <div class={`gallery ${isTall ? 'gallery--tall' : ''}`}>
        <div class="main-image" id="mainImageWrap">
          {firstPhoto && firstPhoto.big && typeof firstPhoto.big !== 'string' ? (
            <Image
              id="mainImage"
              src={firstPhoto.big}
              alt={product.title}
              width={isTall ? 450 : 600}
              height={isTall ? 600 : 450}
              fit="contain"
              format="webp"
              quality={88}
            />
          ) : firstPhoto ? (
            <img id="mainImage" src={String(firstPhoto.big)} alt={product.title} />
          ) : (
            <div class="no-photo">Фото появится скоро</div>
          )}
        </div>
        {photos.length > 1 && (
          <div class="thumbs-scroll" id="thumbsWrap">
            {photos.map((ph, i) => {
              const isActive = i === 0;
              return (
                <button type="button" class={`thumb-btn ${isActive ? 'active' : ''}`} data-idx={i}>
                  {ph.thumb && typeof ph.thumb !== 'string' ? (
                    <Image src={ph.thumb} width={120} height={90} fit="contain" alt="" format="webp" quality={70} />
                  ) : <img src={String(ph.thumb || ph.rel)} alt="" width={120} height={90} />}
                </button>
              );
            })}
          </div>
        )}
      </div>

      {/* ===== ПРАВО: цена / кнопка ===== */}
      <aside class="info-card">
        {product.brand && <div class="brand-pill">{product.brand}</div>}

        <div class="top-meta">
          {product.article && <div class="article-pill">Арт. <b>{product.article}</b></div>}
        </div>

        <div class="price-block">
          <div class="price-main">{price.toLocaleString('ru-RU')} ₽</div>
          {oldPrice && (
            <>
              <div class="price-old">{oldPrice.toLocaleString('ru-RU')} ₽</div>
              <div class="discount-badge">−{Math.round((1 - price / oldPrice) * 100)}%</div>
            </>
          )}
          <div class="price-vat-note">в том числе НДС 22%</div>
        </div>

        <button class="btn-primary" id="contact-btn">Забронировать</button>
        <p class="btn-sub">Менеджер перезвонит в течение 15 минут в рабочее время</p>
      </aside>
    </div>

    {/* ============== 2) НИЖНЯЯ ЧАСТЬ (ВСЯ ШИРИНА) ============== */}
    <div class="product-bottom">

      {fullText && fullText.trim() && (
        <section class="bottom-section about-wide">
          <h2 class="h2-section">О товаре</h2>
          <div class="about-product">
            {fullText.includes('<') || fullText.includes('&#') ? (
              <Fragment set:html={fullText} />
            ) : (
              fullText.split(/\n+/).map((para, i) => {
                const t = para.trim();
                if (!t) return null;
                return <p key={i}>{t}</p>;
              })
            )}
          </div>
        </section>
      )}

      {hasChars && (
        <section class="bottom-section">
          <h2 class="h2-section">Технические характеристики</h2>
          <div class="chars-wrap chars-narrow">
            <table class="chars-table">
              <tbody>
                {finalCharList.map(([key, name, v]) => (
                  <tr key={key} class="ch-row">
                    <td class="ch-name">{name}</td>
                    <td class="ch-value"><strong>{v}</strong></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )}

      {/* =====⭐⭐⭐ ОФЕРТА (СТ. 435 / Ч.2 СТ. 437 ГК РФ) — ПОСЛЕ ТТХ ===== */}
      <section class="bottom-section offer-notice">
        <div class="offer-box">
          <p class="offer-star">*</p>
          <p class="offer-text">
            Информация, опубликованная на Сайте, носит исключительно информационный характер и ни при каких обстоятельствах не является публичной офертой, определяемой положениями ст.&nbsp;435 и ч.&nbsp;2 ст.&nbsp;437 Гражданского кодекса Российской Федерации. Сведения о товаре, его характеристиках, комплектации и цене представлены на Сайте для ознакомления.
          </p>
        </div>
      </section>

      {related.length > 0 && (
        <section class="bottom-section">
          <h2 class="h2-section">Сопутствующие товары</h2>
          <div class={`grid-4col ${mainCatSlug === 'lodochnye-motory' ? 'grid--tall' : ''}`}>
            {related.map(r => {
              const rImg = r.photo?.[0];
              const rImgOp = getProductImage(rImg, 'aksessuary');
              return (
                <a href={`/catalog/${mainCatSlug}/${r.brandSlug || 'aksessuary'}/${r.modelSlug}`} class="related-card">
                  <div class={`rcard-img ${mainCatSlug === 'lodochnye-motory' ? 'rcard-img--tall' : ''}`}>
                    {rImgOp ? (
                      <Image src={rImgOp} width={260} height={195} fit="contain" loading="lazy" alt={r.title} format="webp" quality={75} />
                    ) : <img src={rImg || '/placeholder.jpg'} alt={r.title} width={260} height={195} loading="lazy" />}
                  </div>
                  <div class="rcard-body">
                    <h4>{r.title}</h4>
                    {r.price ? <div class="rcard-price">{r.price.toLocaleString('ru-RU')} ₽</div> : <div class="rcard-price no-price">Цена уточняется</div>}
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      )}

    </div>
  </div>
</Layout>

