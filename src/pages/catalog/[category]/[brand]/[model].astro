.modal .btn-primary { margin-top: 0.4rem; font-size: 1rem; padding: 0.9rem; }
.form-law { margin: 0.6rem 0 0; font-size: 0.75rem; color: #9ca3af; text-align: center; }
</style>

<script>
/**
 * ⚠️ ВАНИЛЬНЫЙ JS — БЕЗ ЗАВИСИМОСТЕЙ
 * 1) Переключение большой картинки по клику на миниатюру
 * 2) Модалка заявки
 */
document.addEventListener('DOMContentLoaded', () => {

  // ===== 1) Галерея: клик по миниатюре =====
  const mainBox = document.getElementById('main-image-box');
  const mainImg = document.getElementById('product-main-image');
  const thumbs = document.querySelectorAll<HTMLButtonElement>('.thumb');
  if (mainImg && thumbs.length > 0) {
    // Запоминаем исходные атрибуты первого фото (srcset и т.д. для Image) — не нужно,
    // т.к. Astro:assets отдает <img src="..." srcset="..." sizes="...">. Мы просто заменяем src/srcset.
    const originals: { src: string | null; srcset: string | null; sizes: string | null; data: any }[] = [];
    thumbs.forEach((btn) => {
      const pic = btn.querySelector('img');
      // Для картинки миниатюры astro:assets подставляет srcset тоже.
      // Но нам нужен БОЛЬШОЙ вариант. В нашем случае один и тот же импорт — thumb и big используют одну и ту же исходную картинку,
      // а Image генерирует свои srcset. Быстрее всего: вытащить src из thumb_img, заменить на /_astro/ большого аналога.
      // АЛГОРИТМ: в data-main у главного img хранится исходный src. Миниатюра — содержит тот же путь,
      // поэтому просто скопируем srcset главного с заменой aspect ratio не нужно — наш контейнер contain.
      // ⭐ Самый простой и стабильный подход — ОБМЕН атрибутами:
      originals.push({
        src: pic?.getAttribute('src') || null,
        srcset: pic?.getAttribute('srcset') || null,
        sizes: pic?.getAttribute('sizes') || null,
        data: pic
      });

      btn.addEventListener('click', () => {
        const tImg = btn.querySelector('img');
        if (!tImg || !mainImg) return;
        // ✅ Просто копируем src + srcset + sizes с миниатюры (один и тот же asset).
        // astro:assets сгенерировал для Image несколько размеров — они подойдут и как big.
        const src = tImg.getAttribute('src');
        const srcset = tImg.getAttribute('srcset');
        const sizes = tImg.getAttribute('sizes');
        if (src) mainImg.setAttribute('src', src);
        if (srcset) mainImg.setAttribute('srcset', srcset);
        if (sizes) mainImg.setAttribute('sizes', sizes);
        mainImg.removeAttribute('width');
        mainImg.removeAttribute('height');
        // АКТИВНЫЙ СТИЛЬ
        thumbs.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
      });
    });
  }

  // ===== 2) Модалка =====
  const btn = document.getElementById('contact-btn');
  const modal = document.getElementById('contact-modal');
  const closeBtn = document.getElementById('modal-close');
  const form = document.getElementById('contact-form');
  if (btn && modal) {
    const open = () => { modal.style.display = 'flex'; document.body.style.overflow = 'hidden'; };
    const shut = () => { modal.style.display = 'none'; document.body.style.overflow = ''; };
    btn.addEventListener('click', open);
    closeBtn?.addEventListener('click', shut);
    window.addEventListener('keydown', (e) => { if (e.key === 'Escape') shut(); });
    modal.addEventListener('click', (e) => { if (e.target === modal) shut(); });
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      // TODO: здесь подключить реальную отправку на почту / Telegram API / Formspree
      alert('✅ Спасибо! Ваша заявка принята. Менеджер свяжется с вами в течение 15 минут.');
      shut();
    });
  }
});
</script>
