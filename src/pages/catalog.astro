---
import Layout from '../layouts/Layout.astro';
import categories from '../data/categories.json';

const CATEGORY_PAGES: Record<string, string> = {
  aksessuary: '/catalog-aksessuary',
  ekipirovka: '/odezhda-i-ehkipirovka',
  zapchasti: '/parts',
  service: '/service',
};
---

<Layout title="Каталог">
  <h1>Каталог</h1>
  <p>Выберите категорию:</p>
  <div class="categories-grid">
    {categories.map((cat) => (
      <a href={CATEGORY_PAGES[cat.slug] ?? `/catalog/${cat.slug}`} class="category-link">
        {cat.title}
      </a>
    ))}
  </div>
</Layout>

<style>
  .categories-grid { display: flex; flex-wrap: wrap; gap: 1rem; padding: 1rem; }
  .category-link {
    padding: 1rem 2rem; border: 1px solid #ddd; border-radius: 8px;
    text-decoration: none; color: #333; transition: background 0.2s;
  }
  .category-link:hover { background: #f5f5f5; }
</style>
